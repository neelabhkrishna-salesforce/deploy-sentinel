{
  "name": "agentia-plugin-deploy-sentinel",
  "description": "Post-deployment smoke testing, evidence capture and bug filing for Copado promotions",
  "version": "0.1.0",
  "author": "Neelabh Krishna",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": "./dist/index.js",
  "license": "MIT",
  "keywords": [
    "oclif-plugin",
    "agentia",
    "copado",
    "salesforce",
    "qa",
    "smoke-testing"
  ],
  "files": [
    "/dist",
    "/oclif.manifest.json",
    "/fixtures",
    "/sentinel.config.json"
  ],
  "dependencies": {
    "@copado/agentia-plugin-sdk": "^0.1.1",
    "fast-xml-parser": "^4.5.0"
  },
  "peerDependencies": {
    "@oclif/core": "^4"
  },
  "devDependencies": {
    "@oclif/core": "^4",
    "@types/node": "^22",
    "oclif": "^4",
    "shx": "^0.3.3",
    "typescript": "^5",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "agentia": {
    "hostApi": 1,
    "requires": [
      "auth.status",
      "format.table",
      "work.getWorkItem"
    ],
    "permissions": {
      "network": [
        "*.atlassian.net"
      ],
      "files": "read-write: sentinel config, git working tree, CRT xUnit and artifacts input, report output directory",
      "commands": [
        "git"
      ],
      "env": [
        "JIRA_BASE_URL",
        "JIRA_EMAIL",
        "JIRA_API_TOKEN"
      ]
    }
  },
  "oclif": {
    "bin": "agentia",
    "dirname": "agentia-cli",
    "commands": "./dist/commands",
    "topics": {
      "sentinel": {
        "description": "Post-deployment smoke testing, evidence capture and bug filing for Copado promotions"
      }
    }
  },
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "clean": "shx rm -f oclif.manifest.json",
    "test": "vitest run",
    "prepack": "npm run build && oclif manifest",
    "postpack": "npm run clean"
  }
}
